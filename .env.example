# URL pública de la tienda (sin barra final). En Vercel: https://tu-dominio.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# ¡Solo servidor! Nunca la expongas en el navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe → Developers → API keys (usa sk_live_ en producción)
STRIPE_SECRET_KEY=
# Stripe → Developers → Webhooks → endpoint https://tu-dominio.com/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=
